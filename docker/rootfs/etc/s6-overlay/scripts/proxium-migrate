#!/command/with-contenv sh
# Migrations, then the first superuser with SUPERUSER_CREATE=true: SUPERUSER_EMAIL and SUPERUSER_PASSWORD are required.
set -eu
. /etc/s6-overlay/scripts/common.sh

# Only the proxy and the API use the database.
if ! service_enabled proxy && ! service_enabled api; then
  exit 0
fi

# Enough for the bundled database to start, or an external one to come up next to it.
s6-setuidgid proxium proxium-manage migrate --wait 60
if [ "$SUPERUSER_CREATE" = true ]; then
  # Fails without the email or the password. Later starts skip the existing user.
  s6-setuidgid proxium proxium-manage createsuperuser --no-input --if-missing
fi
