# PostgreSQL connection URL. Any postgres scheme works, it's converted to postgresql+asyncpg.
# Docker: unset runs the bundled PostgreSQL in the volume.
DATABASE_URL=postgres://user:password@host:5432/db_name
# Encrypts secrets kept in the database, e.g. private keys of TLS certificates. The same in every process.
# Generate: `python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"`.
# Changing it makes stored keys unreadable: upload the certificates again.
ENCRYPTION_KEY=
# Comma-separated previous keys, only during key rotation: they still decrypt while
# `proxium-manage rotateencryptionkey` moves secrets to ENCRYPTION_KEY. Remove them once it's done.
# ENCRYPTION_OLD_KEYS=
# Secret that signs API user tokens, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`.
# At least 32 characters. Changing it logs everyone out.
API_SECRET_KEY=KEEP-IN-PRODUCTION-SECRET-CHANGE-ME-PLEASE
# Comma-separated browser origins allowed to call the API, e.g. the frontend dev server. Empty blocks all.
# Docker doesn't need it: the admin UI and the API share one origin.
API_CORS_ORIGINS=http://localhost:5173
# IPs in one outgoing IP pool at most.
API_OUTGOING_POOL_MAX_SIZE=256
# Policies assigned to one account or trusted network at most.
API_POLICIES_MAX_PER_OWNER=32

# Log every SQL query. Parameters are always hidden: they may hold passwords and tokens.
DATABASE_ECHO=false

# Connection pool of each process (proxy, admin): kept open, extra under load, seconds to wait for a free one,
# seconds after which a connection is replaced (-1 never).
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=-1

# Comma-separated host:port pairs to listen on. A host is an IP (0.0.0.0 or [::] for all interfaces),
# a network (10.0.0.0/29) or a host name (localhost); IPv6 goes in brackets. Ports may be a range: 10000-10999.
PROXY_LISTEN=127.0.0.1:8080

# Seconds open connections get to finish on shutdown.
PROXY_GRACEFUL_TIMEOUT=30

# Proxy log level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
PROXY_LOG_LEVEL=INFO

# Seconds between lookups of the settings edited in the admin: how soon new connections get the changes.
PROXY_SETTINGS_POLL_INTERVAL=5

# `proxium-manage createsuperuser --no-input` only, a flag wins over its variable. Without it the command prompts.
# Name and surname are blank by default. Don't keep a real password here.
# Docker: SUPERUSER_CREATE=true creates this superuser on start, the email and the password are required then.
# SUPERUSER_EMAIL=admin@example.com
# SUPERUSER_PASSWORD=
# SUPERUSER_NAME=
# SUPERUSER_SURNAME=

# --- Docker image ---
# ENCRYPTION_KEY and API_SECRET_KEY may be left unset there: they're generated once and kept in the volume.

# Services this container runs, comma-separated: proxy, api, admin. E.g. only `proxy` to scale it out.
# PROXIUM_SERVICES=proxy,api,admin
# Create the superuser from SUPERUSER_* on start: true or false, the default. An existing one is skipped.
# SUPERUSER_CREATE=false
# Where the API listens: a socket by default, host:port when the admin UI runs in another container.
# API_BIND=unix:/run/proxium/api.sock

# How the admin UI is served:
#   off      - plain HTTP, the default: a closed network or behind your own load balancer;
#   auto     - ACME certificate for ADMIN_HOST: Let's Encrypt, or ADMIN_ACME_CA;
#   files    - own certificate for ADMIN_HOST: cert.pem and key.pem mounted to /certs;
#   internal - self-signed by Caddy, no internet needed.
# ADMIN_TLS=off
# Admin host name, e.g. admin.example.com. Needed by auto and files, internal defaults to localhost.
# ADMIN_HOST=
# Own ACME server for ADMIN_TLS=auto instead of Let's Encrypt, e.g. https://ca.corp.lan/acme/directory.
# ADMIN_ACME_CA=
# Ports of the admin UI, e.g. when 80 and 443 are taken on the host with --network host.
# ADMIN_HTTP_PORT=80
# ADMIN_HTTPS_PORT=443
# Where the admin UI finds the API: the socket in this container by default, host:port when it runs elsewhere.
# ADMIN_API_UPSTREAM=unix//run/proxium/api.sock
