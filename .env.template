# PostgreSQL connection URL. Any postgres scheme works, it's converted to postgresql+asyncpg.
DATABASE_URL=postgres://user:password@host:5432/db_name

# Log every SQL query. Parameters are always hidden: they may hold passwords and tokens.
DATABASE_ECHO=false

# Connection pool of each process (proxy, admin): kept open, extra under load, seconds to wait for a free one,
# seconds after which a connection is replaced (-1 never).
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=-1

# Comma-separated host:port pairs to listen on. A host is an IP (0.0.0.0 or [::] for all interfaces),
# a network (10.0.0.0/29) or a host name (localhost); IPv6 goes in brackets. Ports may be a range: 10000-10999.
PROXY_LISTEN=127.0.0.1:8080

# Seconds open connections get to finish on shutdown.
PROXY_GRACEFUL_TIMEOUT=30

# Proxy log level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
PROXY_LOG_LEVEL=INFO
