# Local test settings: copy to .env.test. pytest reads only this file, never .env.

# PostgreSQL server for acceptance tests. Only its server and credentials are used: the tests create test_<db_name>
# next to the database, drop it after the run and never touch db_name itself. The user needs CREATEDB.
DATABASE_URL=postgres://user:password@localhost:5432/proxium

# Redis for acceptance tests, redis://localhost:6379/0 by default. They take and drop keys only under
# test_<REDIS_KEY_PREFIX>, e.g. test_proxium:lock:migrate, never an instance's.
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=
